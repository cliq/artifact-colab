# Path to the SQLite database file
DATABASE_PATH=./data/app.db

# Resend API key used to send notification emails
RESEND_API_KEY=

# From address used when sending emails via Resend
EMAIL_FROM=

# Comma-separated list of instance admin emails. These can always sign in,
# manage teams/domains/admins at /admin, and cannot be demoted from the UI.
INSTANCE_ADMIN_EMAILS=

# Public base URL of this deployment (used to build links in emails, etc.)
BASE_URL=http://localhost:3000

# Port the HTTP server listens on
PORT=3000

# Open self sign-up: when "true", anyone may sign in and new users with no
# team get a first-run wizard to create their own (optionally claiming their
# email domain for auto-join). Default off — only invited/auto-join/admin
# emails can sign in.
SELF_SIGNUP=false

# PRODUCTION — uncomment both to run behind the bundled Caddy reverse proxy
# (TLS on ports 80/443 with automatic Let's Encrypt certificates for DOMAIN).
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.prod.yml
# DOMAIN=colab.yourcompany.com

# Optional override for the CDN allowlist used when sandboxing artifact frames
# (defaults to a built-in allowlist if left unset)
FRAME_CDN_ALLOWLIST=

# DEV ONLY — when set, this exact code is always accepted at sign-in for any
# email that passes the sign-in gate, no email delivery needed. NEVER set in
# production — the server refuses to start with it when NODE_ENV=production.
# DEV_LOGIN_CODE=123456

# DEV/TEST ONLY — when set, sign-in codes are appended to this file
# ("email code" per line) instead of being sent via Resend.
# DEV_LOGIN_CODE_FILE=./data/codes.log

# DEV/TEST ONLY — when set, comment digest emails are appended to this file
# (one JSON object per line) instead of being sent via Resend.
# DEV_EMAIL_FILE=./data/emails.log
